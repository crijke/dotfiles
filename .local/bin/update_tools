#!/bin/zsh

# Detect OS
OS="$(uname -s)"

# vim
vim -v +PlugUpgrade +qall
vim -v +PlugUpdate +qall

if [[ "$OS" == "Darwin" ]]; then
    # macOS
    brew update
    brew upgrade
    brew cleanup
    brew doctor
    open /Applications/JetBrains\ Toolbox.app
elif [[ "$OS" == "Linux" ]]; then
    # Fedora
    sudo dnf upgrade --refresh -y
    sudo dnf autoremove -y
    sudo dnf clean all
    ~/.local/share/JetBrains/Toolbox/bin/jetbrains-toolbox > /dev/null &
fi

