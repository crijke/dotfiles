#!/bin/zsh

# homebrew
brew update
brew upgrade
brew cleanup
brew doctor

# vim
vim -v +PlugUpgrade +qall
vim -v +PlugUpdate +qall

# node lts
 export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
nvm install --lts

# dev tools
gh extensions upgrade --all
open /Applications/JetBrains\ Toolbox.app

